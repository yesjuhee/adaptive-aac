# Optional. Copy to .env; nothing is sent until cloud suggestions are enabled in Settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AAC_PORT=8765
AAC_DB_PATH=var/aac.sqlite3
# auto loads the model activated by setup_local.py; off disables local inference.
AAC_LOCAL_MODEL=auto
# Optional manual local adapter directory (with AAC_LOCAL_MODEL=<model directory>).
AAC_LOCAL_ADAPTER=
# Manual model paths: auto picks MLX on Apple Silicon, Transformers elsewhere.
AAC_LOCAL_BACKEND=auto
# Transformers: auto uses CUDA when available, otherwise CPU.
AAC_LOCAL_DEVICE=auto
# Deployment behind a reverse proxy only. Defaults keep the server on localhost.
AAC_HOST=127.0.0.1
# Comma-separated extra Host headers and Origins to accept (e.g. aac.example.com, https://aac.example.com).
AAC_ALLOWED_HOSTS=
AAC_ALLOWED_ORIGINS=
